<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android TV ana ekranına "Favoriler" satırı eklemek için -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Ekran yansıtma (telefon tarafı) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV features: touchscreen is NOT required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".KapukayaApplication"
        android:allowBackup="true"
        android:banner="@drawable/logo"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.KapukayaTv"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen (ONLY ENTRY POINT for LAUNCHER and LEANBACK_LAUNCHER) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KapukayaTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- TV ana ekranındaki kanal kartları: kapukayatv://channel/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kapukayatv" />
            </intent-filter>
        </activity>

        <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Player Screen with PiP support -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Settings Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Tam ekran yayın akışı rehberi -->
        <activity
            android:name=".GuideActivity"
            android:exported="false"
            android:label="@string/guide_title"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Telefondan yönetim (QR kod) -->
        <activity
            android:name=".RemoteSetupActivity"
            android:exported="false"
            android:label="@string/remote_setup_title"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Açılış seçimi: Televizyon İzle / Ekran Yansıt -->
        <activity
            android:name=".LaunchChoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.KapukayaTv" />

        <!-- Ekran yansıtma menüsü, alıcı (TV) ve gönderici (telefon) -->
        <activity
            android:name=".MirrorMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.KapukayaTv" />
        <activity
            android:name=".MirrorReceiverActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:theme="@style/Theme.KapukayaTv" />
        <activity
            android:name=".MirrorSenderActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.KapukayaTv" />

        <service
            android:name=".mirror.MirrorSenderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Boot Completed Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
