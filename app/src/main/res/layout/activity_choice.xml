<?xml version="1.0" encoding="utf-8"?>
<!-- Açılış seçimi ve yansıtma menüsü için ortak iki kartlı ekran -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="KAPUKAYA"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@color/accent_red"
            android:fontFamily="sans-serif-black"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="TV"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChoiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        tools:text="Ne yapmak istersiniz?" />

    <LinearLayout
        android:id="@+id/choiceCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/cardFirst"
            layout="@layout/view_choice_card" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <include
            android:id="@+id/cardSecond"
            layout="@layout/view_choice_card" />
    </LinearLayout>

    <Button
        android:id="@+id/btnChoiceExtra"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_selector"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="TV'nin yerleşik yansıtmasını kullan"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvChoiceFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="Bu ekranı Ayarlar'dan kapatabilirsiniz" />
</LinearLayout>
