<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer Video View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Loading Spinner & Logo Overlay -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osd_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLoadingLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/all_channels"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv" />

        <ProgressBar
            android:id="@+id/pbLoading"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/accent_blue" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="Kanal Yükleniyor…"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Error / Retry text if loading takes > 5 sec -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxWidth="280dp"
            android:text="@string/stream_error"
            android:textColor="@color/accent_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRetryHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/retrying"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Top Network Error Banner -->
    <TextView
        android:id="@+id/tvNetworkErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:elevation="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/no_internet"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Remote Control Number Input Overlay (Zapping) -->
    <TextView
        android:id="@+id/tvNumberInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_osd_panel"
        android:elevation="16dp"
        android:fontFamily="sans-serif-bold"
        android:paddingStart="28dp"
        android:paddingTop="12dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp"
        android:textColor="@color/accent_blue"
        android:textSize="36sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="25"
        tools:visibility="visible" />

    <!-- Left Side Zapping Menu (Channel List Panel) -->
    <LinearLayout
        android:id="@+id/zappingMenuContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_zapping_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25">

        <TextView
            android:id="@+id/tvZappingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="@string/all_channels"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvZappingChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_zapping_channel" />
    </LinearLayout>

    <!-- Left Side Category Selection Panel (Daha Küçük, Kategoriler Listesi) -->
    <LinearLayout
        android:id="@+id/zappingCategoryContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_zapping_panel"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.20">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="@string/select_category"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llCategoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Right Side Player Options (Search & Tools) -->
    <LinearLayout
        android:id="@+id/playerOptionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_zapping_panel"
        android:elevation="20dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="@string/player_options_title"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPlayerSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_category_tab"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPlayerVoiceSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🎤 Sesli Arama"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAspectRatio"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="📺 Görüntü: Sığdır"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAudioTrack"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🔊 Ses Dili / Parçası"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnVideoQuality"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⚙ Görüntü Kalitesi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSleepTimer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="⏾ Uyku Zamanlayıcı: Kapalı"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenGuide"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🗓 Yayın Akışı Rehberi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReloadStream"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_selector"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:fontFamily="sans-serif-bold"
            android:gravity="center_vertical|start"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="↻ Yayını Yeniden Yükle"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom OSD (On-Screen Display with TV Overscan Margins) -->
    <include
        android:id="@+id/osdView"
        layout="@layout/layout_osd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
