<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSenderBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_selector"
                android:contentDescription="Geri"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/mirror_send"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Durum kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_zapping_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvSenderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="Salon TV'ye yansıtılıyor (ses açık)" />

            <TextView
                android:id="@+id/tvSenderHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Uygulamadan çıkabilirsiniz; yansıtma bildirimden durdurulabilir." />

            <Button
                android:id="@+id/btnStopMirroring"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_continue_button"
                android:fontFamily="sans-serif-bold"
                android:text="@string/mirror_stop"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Huawei, Xiaomi, Oppo vb. için pil yönetimi uyarısı -->
        <LinearLayout
            android:id="@+id/batteryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_zapping_panel"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/battery_tip_title"
                android:textColor="@color/accent_gold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBatteryTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Huawei cihazlarda…" />

            <Button
                android:id="@+id/btnBatterySettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_selector"
                android:fontFamily="sans-serif-medium"
                android:text="@string/battery_tip_open"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBatteryDismiss"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif"
                android:text="@string/battery_tip_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/mirror_found_devices"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSenderSearching"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/mirror_searching"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Bulunan TV'ler (kod ile eklenir) -->
        <LinearLayout
            android:id="@+id/llTargets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnManualIp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_selector"
            android:fontFamily="sans-serif-medium"
            android:text="@string/mirror_manual_ip"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="@string/mirror_sender_notes"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
