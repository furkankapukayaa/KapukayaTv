<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/osdContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_osd_panel"
    android:clickable="true"
    android:focusable="false"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <!-- Büyük kanal logosu -->
    <ImageView
        android:id="@+id/ivOsdLogo"
        android:layout_width="88dp"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_channel_card"
        android:contentDescription="@string/all_channels"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tv" />

    <!-- Kanal bilgileri -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/accent_red"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="● CANLI"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvOsdResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quality_badge"
                android:fontFamily="sans-serif-black"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="1080p"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvOsdCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                tools:text="Genel · Haber" />

            <TextView
                android:id="@+id/tvOsdSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="⏾ 30 dk"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOsdChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            tools:text="1. TRT 1" />

        <!-- Yayın akışı (EPG): şimdi / sonra -->
        <LinearLayout
            android:id="@+id/osdEpgContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvOsdNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Şimdi  20:00 – 21:30  Ana Haber" />

            <ProgressBar
                android:id="@+id/pbOsdEpg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:max="100"
                android:progressDrawable="@drawable/bg_epg_progress"
                tools:progress="35" />

            <TextView
                android:id="@+id/tvOsdNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Sonra  21:30  Dizi" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOsdEpgHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="@string/osd_remote_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sağ taraf: saat ve işlem butonları -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="end"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnOsdChannelList"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:contentDescription="@string/channel_list"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_list" />

            <ImageButton
                android:id="@+id/btnOsdOptions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:contentDescription="@string/player_options"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <ImageButton
                android:id="@+id/btnOsdAddCategory"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:contentDescription="@string/add_to_category"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder_plus" />

            <ImageButton
                android:id="@+id/btnOsdFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_selector"
                android:contentDescription="@string/favorites"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star_border" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
