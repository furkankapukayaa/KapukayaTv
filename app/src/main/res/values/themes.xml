<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KapukayaTv" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>

        <!-- Dark Dialog Theme Enforcements -->
        <item name="alertDialogTheme">@style/DarkDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/DarkDialogTheme</item>
        <item name="android:alertDialogTheme">@style/DarkDialogTheme</item>
    </style>

    <style name="DarkDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="dialogCornerRadius">20dp</item>
    </style>
</resources>
