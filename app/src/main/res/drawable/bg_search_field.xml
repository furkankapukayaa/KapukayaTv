<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_top" />
            <corners android:radius="22dp" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/bg_card_top"
                android:endColor="@color/bg_card"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/card_stroke_unfocused" />
        </shape>
    </item>
</selector>
