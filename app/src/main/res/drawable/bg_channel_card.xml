<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Taşıma modu: kırmızı çerçeve -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="3dp" android:color="@color/accent_red" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_top" />
            <stroke android:width="3dp" android:color="@color/white" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
