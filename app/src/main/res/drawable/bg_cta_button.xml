<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/accent_blue_light"
                android:endColor="@color/accent_primary"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/accent_primary_light"
                android:endColor="@color/accent_primary_deep"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/accent_primary_light"
                android:endColor="@color/accent_primary_deep"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
