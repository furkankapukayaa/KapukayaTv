<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <corners android:radius="20dp" />
            <stroke android:width="2.5dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="@color/accent_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/card_stroke_unfocused" />
        </shape>
    </item>
</selector>
